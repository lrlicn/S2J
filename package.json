{
  "name": "s2j",
  "type": "module",
  "version": "0.1.0",
  "description": "S2J - Simple to Java, a modern Java learning website with simple and clear tutorials",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "new:post": "node scripts/new-post.mjs",
    "lint": "eslint . --ext .js,.ts,.astro",
    "lint:fix": "eslint . --ext .js,.ts,.astro --fix",
    "format": "prettier --write \"src/**/*.{astro,js,ts,md,mdx,css}\"",
    "format:check": "prettier --check \"src/**/*.{astro,js,ts,md,mdx,css}\""
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^5.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^5.5.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13",
    "marked-highlight": "^2.2.4",
    "pagefind": "^1.5.2",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
