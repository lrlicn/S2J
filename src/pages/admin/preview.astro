---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="预览 | S2J" description="文章预览">
  <div class="container-page py-12">
    <article class="max-w-3xl mx-auto">
      <!-- 文章头部 -->
      <header class="mb-8 pb-8 border-b border-slate-200 dark:border-slate-700">
        <div class="flex items-center gap-3 mb-4">
          <span id="preview-category" class="tag"></span>
          <span id="preview-featured" class="hidden inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-accent-100 text-accent-800 dark:bg-accent-900/40 dark:text-accent-300">精选</span>
        </div>
        <div class="mb-4">
          <h1 id="preview-title" style="display: inline-block; border-radius: 9999px;" class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white leading-tight px-6 py-2.5 bg-brand-50 dark:bg-brand-900/30"></h1>
        </div>
        <p id="preview-description" class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed mb-6"></p>
        <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500 dark:text-slate-400">
          <span>S2J</span>
          <span id="preview-date"></span>
        </div>
      </header>

      <!-- 文章内容 -->
      <div id="preview-content" class="prose prose-slate dark:prose-invert max-w-none prose-headings:scroll-mt-24 prose-a:text-brand-600 dark:prose-a:text-brand-400"></div>

      <!-- 底部操作按钮 -->
      <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-700 text-center">
        <button id="btn-edit" class="px-6 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg transition-colors">编辑文章</button>
      </div>
    </article>
  </div>

  <script>
    import { marked } from 'marked';
    import { markedHighlight } from 'marked-highlight';
    import hljs from 'highlight.js/lib/core';
    import langJava from 'highlight.js/lib/languages/java';
    import langJavascript from 'highlight.js/lib/languages/javascript';
    import langTypescript from 'highlight.js/lib/languages/typescript';
    import langBash from 'highlight.js/lib/languages/bash';
    import langJson from 'highlight.js/lib/languages/json';
    import langXml from 'highlight.js/lib/languages/xml';
    import langCss from 'highlight.js/lib/languages/css';
    import langYaml from 'highlight.js/lib/languages/yaml';
    import langDiff from 'highlight.js/lib/languages/diff';
    import langSql from 'highlight.js/lib/languages/sql';

    [['java', langJava], ['javascript', langJavascript], ['typescript', langTypescript],
     ['bash', langBash], ['json', langJson], ['xml', langXml], ['css', langCss],
     ['yaml', langYaml], ['diff', langDiff], ['sql', langSql]]
      .forEach(([name, mod]) => hljs.registerLanguage(name, mod));

    marked.use(markedHighlight({
      langPrefix: 'hljs language-',
      highlight(code, lang) {
        const language = hljs.getLanguage(lang) ? lang : 'plaintext';
        try { return hljs.highlight(code, { language }).value; }
        catch { return code; }
      },
    }));

    // 从 sessionStorage 读取预览数据
    const raw = sessionStorage.getItem('s2j_preview_data');
    if (!raw) {
      document.getElementById('preview-content').innerHTML = '<p class="text-slate-500">没有找到预览数据</p>';
      document.getElementById('btn-edit').style.display = 'none';
    } else {
      const data = JSON.parse(raw);
      
      // 填充文章头部
      document.getElementById('preview-title').textContent = data.title || '未命名文章';
      document.title = `${data.title || '预览'} | S2J`;
      
      const categoryEl = document.getElementById('preview-category');
      if (data.category) {
        categoryEl.textContent = data.category;
      }
      
      const featuredEl = document.getElementById('preview-featured');
      if (data.featured) {
        featuredEl.classList.remove('hidden');
      }
      
      const descEl = document.getElementById('preview-description');
      if (data.description) {
        descEl.textContent = data.description;
      } else {
        descEl.remove();
      }
      
      const dateEl = document.getElementById('preview-date');
      if (data.pubDate) {
        dateEl.textContent = new Date(data.pubDate).toLocaleDateString('zh-CN');
      } else {
        dateEl.remove();
      }

      // 渲染 Markdown 内容
      const contentEl = document.getElementById('preview-content');
      if (data.content) {
        contentEl.innerHTML = marked.parse(data.content);
      }

      // 编辑按钮：
      //   已保存文章（有 slug）→ 在当前标签页打开该文章的编辑页；
      //   新建未保存（无 slug）→ 预览页是编辑器 window.open 出来的子页，直接关闭本页，
      //     让用户回到原编辑器标签页继续写（原页内容仍在，不丢稿）。
      document.getElementById('btn-edit').addEventListener('click', () => {
        if (data.slug) {
          window.location.href = `/admin#/edit/${encodeURIComponent(data.slug)}`;
        } else {
          window.close();
          // 若浏览器拦截了 close（非脚本打开的预览页），兜底回到新建编辑器
          setTimeout(() => { if (!window.closed) window.location.href = '/admin#/edit/new'; }, 150);
        }
      });

      // 预览完成后清理 sessionStorage
      sessionStorage.removeItem('s2j_preview_data');
    }
  </script>

  <style is:global>
    /* 代码块：现代风高亮配色（亮色柔和 · 暗色 Tokyo Night） */
    #preview-content pre {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 0.5rem;
      margin: 1rem 0;
      overflow: auto;
      padding: 1rem;
    }
    html.dark #preview-content pre {
      background: #1a1b26;
      border-color: #292e42;
    }
    #preview-content code.hljs { background: transparent; padding: 0; }
    #preview-content .hljs { color: #1f2328; }
    html.dark #preview-content .hljs { color: #c0caf5; }

    /* 关键字 / 内置类型：紫 → 粉紫 */
    #preview-content .hljs-keyword,
    #preview-content .hljs-selector-tag,
    #preview-content .hljs-built_in { color: #8839ef; font-weight: 500; }
    html.dark #preview-content .hljs-keyword,
    html.dark #preview-content .hljs-selector-tag,
    html.dark #preview-content .hljs-built_in { color: #bb9af7; }

    /* 字符串：柔绿 */
    #preview-content .hljs-string,
    #preview-content .hljs-doctag { color: #2f7d4f; }
    html.dark #preview-content .hljs-string,
    html.dark #preview-content .hljs-doctag { color: #9ece6a; }

    /* 数字 / 字面量：蓝 → 橙 */
    #preview-content .hljs-number,
    #preview-content .hljs-literal,
    #preview-content .hljs-symbol { color: #1e66f5; }
    html.dark #preview-content .hljs-number,
    html.dark #preview-content .hljs-literal,
    html.dark #preview-content .hljs-symbol { color: #ff9e64; }

    /* 注释：灰斜体 */
    #preview-content .hljs-comment,
    #preview-content .hljs-quote { color: #7c7f93; font-style: italic; }
    html.dark #preview-content .hljs-comment,
    html.dark #preview-content .hljs-quote { color: #565f89; font-style: italic; }

    /* 函数 / 类名：蓝紫 → 蓝 */
    #preview-content .hljs-title,
    #preview-content .hljs-title.function_,
    #preview-content .hljs-section { color: #7287fd; }
    html.dark #preview-content .hljs-title,
    html.dark #preview-content .hljs-title.function_,
    html.dark #preview-content .hljs-section { color: #7aa2f7; }

    /* 变量 / 属性：粉 → 青 */
    #preview-content .hljs-attr,
    #preview-content .hljs-attribute,
    #preview-content .hljs-variable,
    #preview-content .hljs-template-variable { color: #d20f39; }
    html.dark #preview-content .hljs-attr,
    html.dark #preview-content .hljs-attribute,
    html.dark #preview-content .hljs-variable,
    html.dark #preview-content .hljs-template-variable { color: #7dcfff; }

    /* 标签 / 选择器：蓝 → 绿 */
    #preview-content .hljs-name,
    #preview-content .hljs-selector-id,
    #preview-content .hljs-selector-class { color: #1e66f5; }
    html.dark #preview-content .hljs-name,
    html.dark #preview-content .hljs-selector-id,
    html.dark #preview-content .hljs-selector-class { color: #9ece6a; }
  </style>
</Layout>
