{/* 首页视图（极简大按钮），显隐与跳转由 router + main.js 统一管理 */}
<div id="admin-home" class="min-h-screen flex flex-col items-center justify-center px-4 bg-gradient-to-br from-slate-50 via-white to-brand-50/30 dark:from-slate-900 dark:via-slate-900 dark:to-slate-800 relative">
  <!-- 右上角主题切换 -->
  <div class="absolute top-5 right-5">
    <button id="home-theme-toggle" class="p-2.5 rounded-xl text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" aria-label="切换主题">
      <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
      <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
    </button>
  </div>

  <!-- Logo + 标题 -->
  <div class="flex flex-col items-center mb-10">
    <img src="/favicon.svg" alt="S2J" class="w-16 h-16 rounded-2xl shadow-lg mb-4" />
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">S2J 文章管理</h1>
  </div>

  <!-- 大按钮组 -->
  <div class="w-full max-w-xs space-y-3">
    <!-- 新建文章（主要按钮） -->
    <button id="home-new-post" class="w-full flex items-center justify-center px-5 py-3.5 bg-brand-600 hover:bg-brand-700 text-white rounded-xl shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all">
      <span class="text-base font-semibold">新建文章</span>
    </button>

    <!-- 管理文章 -->
    <button id="home-manage" class="w-full flex items-center justify-center px-5 py-3.5 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-900 dark:text-white rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
      <span class="text-base font-semibold">管理文章</span>
    </button>

    <!-- 导入文章 -->
    <button id="home-import" class="w-full flex items-center justify-center px-5 py-3.5 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-900 dark:text-white rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
      <span class="text-base font-semibold">导入文章</span>
    </button>

    <!-- 返回网站 -->
    <a href="/" target="_blank" class="w-full flex items-center justify-center gap-2 px-5 py-2.5 text-slate-500 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors text-sm font-medium">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      返回网站
    </a>
  </div>
</div>

<!-- 导入文章弹窗 -->
<div id="import-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
  <div id="import-overlay" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
  <div class="relative w-full max-w-lg bg-white dark:bg-slate-900 rounded-2xl shadow-2xl flex flex-col max-h-[85vh]">
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200 dark:border-slate-700 flex-shrink-0">
      <h3 class="font-bold text-base text-slate-900 dark:text-white">导入文章</h3>
      <button id="import-close" class="p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors" aria-label="关闭">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <div class="flex-1 overflow-y-auto p-6">
      <!-- 拖拽/选择区 -->
      <div id="import-drop" class="border-2 border-dashed border-slate-300 dark:border-slate-600 rounded-xl px-4 py-8 text-center cursor-pointer hover:border-brand-400 transition-colors">
        <svg class="w-8 h-8 mx-auto mb-2 text-slate-300 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.9 5 5 0 019.9-1A5 5 0 0118 15.9M5 20h14a2 2 0 002-2" /></svg>
        <p class="text-sm text-slate-500 dark:text-slate-400">点击选择，或拖拽 .md / .mdx 文件到这里</p>
        <input id="import-file-input" type="file" accept=".md,.mdx" multiple class="hidden" />
      </div>

      <!-- 默认分类 -->
      <div class="mt-4">
        <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1.5">未指定分类时归入</label>
        <select id="import-default-category" class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="java-basics">Java 基础</option>
          <option value="spring">Spring 生态</option>
          <option value="java-ai">Java AI</option>
          <option value="tools">开发工具</option>
          <option value="other">其他</option>
        </select>
      </div>

      <!-- 文件列表 -->
      <div id="import-file-list" class="mt-4 space-y-2"></div>
    </div>
    <div class="flex items-center justify-end gap-2 px-6 py-4 border-t border-slate-200 dark:border-slate-700 flex-shrink-0">
      <button id="import-cancel" class="px-4 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors">取消</button>
      <button id="import-confirm" class="px-4 py-2 text-sm font-medium bg-brand-600 hover:bg-brand-700 text-white rounded-lg transition-colors">导入 0 篇</button>
    </div>
  </div>
</div>
