{/* 全屏编辑器（覆盖层）：整体灰底 + 各区块白色圆角卡片，左卡片预览 / 右流式编辑，交互由 scripts/admin/editor.js 依据路由管理 */}
<div id="editor-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute editor-panel inset-0 bg-slate-100 dark:bg-slate-900 flex flex-col overflow-hidden">

    <!-- 顶部标题栏：与下方主体同一栅格（左 360 占位 + 右 920），标题输入与编辑区对齐 -->
    <div class="flex items-center gap-12 px-6 py-4 bg-gradient-to-b from-brand-50/80 to-white dark:from-slate-800 dark:to-slate-800 hover:from-brand-100 hover:to-brand-50 dark:hover:from-slate-700 dark:hover:to-slate-700 transition-colors flex-shrink-0">
      <div class="w-[360px] flex-shrink-0 hidden lg:block"></div>
      <div class="flex-1 max-w-[920px] flex items-center gap-3 min-w-0">
        <button id="btn-editor-back" class="p-1.5 -ml-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors flex-shrink-0" aria-label="返回">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        </button>
        <input id="field-title" type="text" placeholder="输入文章标题..." class="flex-1 min-w-0 text-2xl font-bold bg-transparent text-slate-900 dark:text-white placeholder-slate-300 dark:placeholder-slate-600 focus:outline-none transition-colors" />
        <span id="draft-indicator" class="text-xs text-amber-500 dark:text-amber-400 flex-shrink-0"></span>
        <button id="btn-close-editor" class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors flex-shrink-0" aria-label="关闭">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
    </div>

    <!-- 主体：左卡片预览 + 右编辑区（卡片与编辑区间距加大） -->
    <div class="flex-1 flex gap-12 overflow-hidden p-4">

      <!-- 左窄栏：文章卡片预览（顶部占位与工具栏等高，使卡片与正文对齐） -->
      <aside class="w-[360px] flex-shrink-0 overflow-y-auto hidden lg:block">
        <div id="aside-toolbar-spacer" class="flex-shrink-0"></div>
        <div id="preview-card-hover" class="rounded-xl shadow-sm overflow-hidden transition-all duration-200 min-h-[260px] cursor-pointer bg-gradient-to-br from-brand-50 to-brand-100/70 dark:from-slate-800 dark:to-slate-900 hover:shadow-md hover:from-brand-100 hover:to-brand-200/70 dark:hover:from-slate-700 dark:hover:to-slate-900">
          <div class="p-5">
            <p class="text-xs font-medium tracking-wide text-slate-400 dark:text-slate-500 mb-3">文章卡片预览</p>
            <div>
              <div class="mb-3 flex items-center gap-2 flex-wrap">
                <span id="preview-card-category" class="tag">未分类</span>
                <span id="preview-card-featured" class="hidden inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-accent-100 text-accent-800 dark:bg-accent-900/40 dark:text-accent-300">精选</span>
              </div>
              <h3 id="preview-card-title" class="text-lg font-bold text-slate-900 dark:text-white leading-snug">未命名文章</h3>
              <p id="preview-card-desc" class="text-base text-slate-500 dark:text-slate-400 mt-2.5 leading-relaxed">填写摘要后，这里会显示文章简介…</p>
              <div id="preview-card-tags" class="mt-3 flex flex-wrap gap-1.5"></div>
            </div>
        </div>
        <div id="outline-panel" class="mt-4"></div>
      </aside>

      <!-- 右宽栏：编辑区（限宽 920，与顶部标题右侧对齐；工具栏 / 正文 / 设置 / 底栏，均为白色卡片） -->
      <div class="flex-1 max-w-[920px] flex flex-col gap-4 overflow-hidden">

        <!-- Markdown 工具栏（集中在编辑区上方） -->
        <div class="md-toolbar bg-white dark:bg-slate-800 rounded-xl flex-shrink-0">
          <div class="flex flex-wrap gap-0.5 flex-1 p-2">
            <button type="button" data-md="bold" title="加粗 (Ctrl+B)"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 0 8H6z"/><path d="M6 12h9a4 4 0 0 1 0 8H6z"/></svg></button>
            <button type="button" data-md="italic" title="斜体 (Ctrl+I)"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="4" x2="10" y2="4"/><line x1="14" y1="20" x2="5" y2="20"/><line x1="15" y1="4" x2="9" y2="20"/></svg></button>
            <button type="button" data-md="strikethrough" title="删除线"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4H9a3 3 0 0 0-2.83 4"/><path d="M14 12a4 4 0 0 1 0 8H6"/><line x1="4" y1="12" x2="20" y2="12"/></svg></button>
            <span class="divider"></span>
            <button type="button" data-md="h1" title="一级标题"><span class="md-heading-btn">H1</span></button>
            <button type="button" data-md="h2" title="二级标题"><span class="md-heading-btn">H2</span></button>
            <button type="button" data-md="h3" title="三级标题"><span class="md-heading-btn">H3</span></button>
            <span class="divider"></span>
            <button type="button" data-md="quote" title="引用"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 11H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4a3 3 0 0 1-3 3"/><path d="M19 11h-4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4a3 3 0 0 1-3 3"/></svg></button>
            <button type="button" data-md="ul" title="无序列表"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></button>
            <button type="button" data-md="ol" title="有序列表"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" y1="6" x2="21" y2="6"/><line x1="10" y1="12" x2="21" y2="12"/><line x1="10" y1="18" x2="21" y2="18"/><path d="M4 6h1v4"/><path d="M4 10h2"/><path d="M6 16H4l2-2H4"/></svg></button>
            <span class="divider"></span>
            <button type="button" data-md="code" title="行内代码"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></button>
            <button type="button" data-md="codeblock" title="代码块"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 10l-2 2 2 2"/><path d="M16 10l2 2-2 2"/></svg></button>
            <button type="button" data-md="link" title="链接"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></button>
            <button type="button" data-md="image" title="图片"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></button>
            <span class="divider"></span>
            <button type="button" data-md="table" title="表格"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/></svg></button>
            <button type="button" data-md="hr" title="分割线"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
          </div>
          <button type="button" id="btn-outline" class="ml-auto p-1 m-1.5 rounded text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors flex-shrink-0 self-end" title="文章大纲">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
          </button>
        </div>

        <!-- 主卡片：正文编辑区 + 设置区，连续滚动（首屏全是编辑区，下滚才见设置） -->
        <div class="flex-1 bg-white dark:bg-slate-800 rounded-xl overflow-y-auto flex flex-col">
          <textarea id="editor-content" class="flex-shrink-0 min-h-full w-full p-5 font-mono text-sm bg-transparent text-slate-800 dark:text-slate-200 focus:outline-none resize-none overflow-hidden"></textarea>
          <div class="mx-6 my-2 h-0.5 flex-shrink-0 rounded-full bg-gradient-to-r from-transparent via-brand-400 to-transparent"></div>

          <!-- 设置区（内联列表项，用间距区分） -->
          <div class="p-5 pt-2 space-y-6">
            <!-- 分类 -->
            <div>
              <div class="mb-1"><span class="text-sm font-medium text-slate-900 dark:text-white">分类</span></div>
              <p class="text-xs text-slate-400 dark:text-slate-500 mb-2">文章所属栏目，用于导航与筛选</p>
              <div class="relative">
                <select id="field-category" class="custom-select w-full px-3 py-2 pr-9 text-sm rounded-lg border border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white hover:border-slate-300 dark:hover:border-slate-500 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors">
                  <option value="java-basics">Java 基础</option>
                  <option value="spring">Spring 生态</option>
                  <option value="java-ai">Java AI</option>
                  <option value="tools">开发工具</option>
                  <option value="other">其他</option>
                </select>
                <svg class="absolute right-2.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 dark:text-slate-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </div>
            </div>

            <!-- 标签 -->
            <div>
              <div class="mb-1"><span class="text-sm font-medium text-slate-900 dark:text-white">标签</span></div>
              <p class="text-xs text-slate-400 dark:text-slate-500 mb-2">回车添加标签，用于文章检索</p>
              <div class="tag-input-container" id="tag-input-container">
                <input type="text" id="tag-input-field" class="tag-input-field" placeholder="回车添加" autocomplete="off" />
              </div>
            </div>

            <!-- 摘要 -->
            <div>
              <div class="flex items-baseline justify-between mb-1">
                <span class="text-sm font-medium text-slate-900 dark:text-white">摘要</span>
                <span class="text-[10px] text-slate-400 dark:text-slate-500"><span id="desc-count">0</span>/120</span>
              </div>
              <p class="text-xs text-slate-400 dark:text-slate-500 mb-2">选填，用于文章列表与分享卡片展示</p>
              <textarea id="field-description" rows="3" maxlength="120" class="w-full px-3 py-2 text-sm rounded-lg border border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white hover:border-slate-300 dark:hover:border-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors resize-none" placeholder="填写一句话摘要..."></textarea>
            </div>

            <!-- 文章链接 -->
            <div>
              <div class="mb-1"><span class="text-sm font-medium text-slate-900 dark:text-white">文章链接</span></div>
              <p class="text-xs text-slate-400 dark:text-slate-500 mb-2">自定义 URL 路径，输入标题自动生成</p>
              <input id="field-slug" type="text" class="w-full px-3 py-2 text-sm rounded-lg border border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white hover:border-slate-300 dark:hover:border-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-500 transition-colors" placeholder="hello-world" />
            </div>

            <!-- 精选 -->
            <div class="flex items-center justify-between">
              <div>
                <div class="text-sm font-medium text-slate-900 dark:text-white">精选文章</div>
                <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">开启后在首页精选位展示</p>
              </div>
              <label class="toggle-switch">
                <input id="field-featured" type="checkbox" class="toggle-input" />
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>
        </div>

        <!-- 底部操作栏（集中在编辑区底部） -->
        <div class="flex items-center justify-between px-4 py-2.5 bg-white dark:bg-slate-800 rounded-xl flex-shrink-0">
          <span id="word-count" class="text-xs text-slate-400 dark:text-slate-500">0 字</span>
          <div class="flex items-center gap-2">
            <button id="btn-preview" class="px-4 py-1.5 text-sm font-medium text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 rounded-lg transition-colors">预览</button>
            <button id="btn-save-draft" class="px-4 py-1.5 text-sm font-medium text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 rounded-lg transition-colors">保存为草稿</button>
            <button id="btn-save-publish" class="px-4 py-1.5 text-sm font-medium bg-brand-600 hover:bg-brand-700 text-white rounded-lg transition-colors">发表</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Markdown 工具栏小浮层（链接/图片/表格） -->
    <div id="md-popover" class="absolute inset-0 z-30 hidden items-center justify-center p-4">
      <div id="md-popover-overlay" class="absolute inset-0 bg-black/30 backdrop-blur-[1px]"></div>
      <div id="md-popover-card" class="relative w-full max-w-sm bg-white dark:bg-slate-900 rounded-xl shadow-2xl p-5 transform scale-95 opacity-0 transition-all duration-150">
        <h3 id="md-popover-title" class="text-base font-bold text-slate-900 dark:text-white mb-4"></h3>
        <div id="md-popover-body" class="space-y-3"></div>
        <div class="flex justify-end gap-2 mt-5">
          <button id="md-popover-cancel" type="button" class="px-4 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors">取消</button>
          <button id="md-popover-confirm" type="button" class="px-4 py-2 text-sm font-medium bg-brand-600 hover:bg-brand-700 text-white rounded-lg transition-colors">插入</button>
        </div>
      </div>
    </div>
  </div>
</div>
