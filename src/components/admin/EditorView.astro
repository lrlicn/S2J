{/* 全屏编辑器（覆盖层），开关与全部交互由 scripts/admin/editor.js 依据路由管理 */}
<div id="editor-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute editor-panel inset-0 bg-white dark:bg-slate-900 flex flex-col overflow-hidden">
    <!-- 顶部工具栏（整合标题输入） -->
    <div class="flex items-center gap-3 px-5 py-2.5 border-b border-slate-200 dark:border-slate-700 flex-shrink-0">
      <button id="btn-editor-back" class="p-1.5 -ml-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors flex-shrink-0" aria-label="返回">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      </button>
      <input id="field-title" type="text" placeholder="输入文章标题..." class="flex-1 min-w-0 text-base font-bold bg-brand-50 dark:bg-brand-900/30 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none rounded-full px-4 py-1.5 transition-colors" />
      <span id="draft-indicator" class="text-xs text-amber-500 dark:text-amber-400 flex-shrink-0"></span>
      <div class="flex items-center gap-1.5 flex-shrink-0">
        <button id="btn-save-draft" class="px-3 py-1.5 text-sm font-medium text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors">保存为草稿</button>
        <button id="btn-preview" class="px-3 py-1.5 text-sm font-medium text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors">预览</button>
        <button id="btn-editor-settings" class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors" title="文章设置（分类、Slug、标签、精选）" aria-label="文章设置">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        </button>
        <button id="btn-save-publish" class="px-3 py-1.5 text-sm font-medium bg-brand-600 hover:bg-brand-700 text-white rounded-lg transition-colors">发表</button>
        <button id="btn-close-editor" class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors" aria-label="关闭">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
    </div>

    <!-- 文章设置弹窗 -->
    <div id="settings-modal" class="absolute inset-0 z-20 hidden items-center justify-center p-4">
      <div id="settings-modal-overlay" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
      <div id="settings-modal-content" class="relative w-full max-w-2xl max-h-[85vh] bg-white dark:bg-slate-900 rounded-2xl shadow-2xl flex flex-col transform scale-95 opacity-0 transition-all duration-200">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200 dark:border-slate-700 flex-shrink-0">
          <h3 class="font-bold text-base text-slate-900 dark:text-white">文章设置</h3>
          <button id="btn-close-settings" class="p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors" aria-label="关闭设置">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
        <div class="flex-1 overflow-y-auto p-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1.5">Slug（URL 路径）</label>
              <input id="field-slug" type="text" class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white hover:border-slate-400 dark:hover:border-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors" placeholder="hello-world" />
              <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-1">文章 URL 路径，输入标题自动生成，可手动修改</p>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1.5">分类</label>
              <div class="relative">
                <select id="field-category" class="custom-select w-full px-3 py-2 pr-9 text-sm rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white hover:border-slate-400 dark:hover:border-slate-500 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors">
                  <option value="java-basics">Java 基础</option>
                  <option value="spring">Spring 生态</option>
                  <option value="java-ai">Java AI</option>
                  <option value="tools">开发工具</option>
                  <option value="other">其他</option>
                </select>
                <svg class="absolute right-2.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 dark:text-slate-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </div>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1.5">标签</label>
              <div class="tag-input-container" id="tag-input-container">
                <input type="text" id="tag-input-field" class="tag-input-field" placeholder="回车添加" autocomplete="off" />
              </div>
            </div>
            <div class="md:col-span-2">
              <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1.5">描述</label>
              <input id="field-description" type="text" class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white hover:border-slate-400 dark:hover:border-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-500 transition-colors" placeholder="文章描述，用于 SEO 和列表展示" />
            </div>
            <div class="md:col-span-2 flex items-center">
              <label class="flex items-center gap-3 cursor-pointer group">
                <span class="toggle-switch">
                  <input id="field-featured" type="checkbox" class="toggle-input" />
                  <span class="toggle-slider"></span>
                </span>
                <span class="text-sm text-slate-600 dark:text-slate-300 group-hover:text-slate-900 dark:group-hover:text-white transition-colors">精选文章</span>
              </label>
            </div>
          </div>
        </div>
        <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-slate-200 dark:border-slate-700 flex-shrink-0">
          <button id="btn-settings-cancel" class="px-4 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors">取消</button>
          <button id="btn-settings-confirm" class="px-4 py-2 text-sm font-medium bg-brand-600 hover:bg-brand-700 text-white rounded-lg transition-colors">确认</button>
        </div>
      </div>
    </div>

    <!-- Markdown 工具栏小浮层（链接/图片/表格） -->
    <div id="md-popover" class="absolute inset-0 z-30 hidden items-center justify-center p-4">
      <div id="md-popover-overlay" class="absolute inset-0 bg-black/30 backdrop-blur-[1px]"></div>
      <div id="md-popover-card" class="relative w-full max-w-sm bg-white dark:bg-slate-900 rounded-xl shadow-2xl p-5 transform scale-95 opacity-0 transition-all duration-150">
        <h3 id="md-popover-title" class="text-base font-bold text-slate-900 dark:text-white mb-4"></h3>
        <div id="md-popover-body" class="space-y-3"></div>
        <div class="flex justify-end gap-2 mt-5">
          <button id="md-popover-cancel" type="button" class="px-4 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors">取消</button>
          <button id="md-popover-confirm" type="button" class="px-4 py-2 text-sm font-medium bg-brand-600 hover:bg-brand-700 text-white rounded-lg transition-colors">插入</button>
        </div>
      </div>
    </div>

    <!-- 整行工具栏 -->
    <div class="md-toolbar border-b border-slate-200 dark:border-slate-700 flex-shrink-0">
      <div class="flex flex-wrap gap-0.5 flex-1">
        <button type="button" data-md="bold" title="加粗 (Ctrl+B)"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 0 8H6z"/><path d="M6 12h9a4 4 0 0 1 0 8H6z"/></svg></button>
        <button type="button" data-md="italic" title="斜体 (Ctrl+I)"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="4" x2="10" y2="4"/><line x1="14" y1="20" x2="5" y2="20"/><line x1="15" y1="4" x2="9" y2="20"/></svg></button>
        <button type="button" data-md="strikethrough" title="删除线"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4H9a3 3 0 0 0-2.83 4"/><path d="M14 12a4 4 0 0 1 0 8H6"/><line x1="4" y1="12" x2="20" y2="12"/></svg></button>
        <span class="divider"></span>
        <button type="button" data-md="h1" title="一级标题"><span class="md-heading-btn">H1</span></button>
        <button type="button" data-md="h2" title="二级标题"><span class="md-heading-btn">H2</span></button>
        <button type="button" data-md="h3" title="三级标题"><span class="md-heading-btn">H3</span></button>
        <span class="divider"></span>
        <button type="button" data-md="quote" title="引用"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 11H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4a3 3 0 0 1-3 3"/><path d="M19 11h-4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4a3 3 0 0 1-3 3"/></svg></button>
        <button type="button" data-md="ul" title="无序列表"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></button>
        <button type="button" data-md="ol" title="有序列表"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" y1="6" x2="21" y2="6"/><line x1="10" y1="12" x2="21" y2="12"/><line x1="10" y1="18" x2="21" y2="18"/><path d="M4 6h1v4"/><path d="M4 10h2"/><path d="M6 16H4l2-2H4"/></svg></button>
        <span class="divider"></span>
        <button type="button" data-md="code" title="行内代码"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></button>
        <button type="button" data-md="codeblock" title="代码块"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 10l-2 2 2 2"/><path d="M16 10l2 2-2 2"/></svg></button>
        <button type="button" data-md="link" title="链接"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></button>
        <button type="button" data-md="image" title="图片"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></button>
        <span class="divider"></span>
        <button type="button" data-md="table" title="表格"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/></svg></button>
        <button type="button" data-md="hr" title="分割线"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
      </div>
      <span id="word-count" class="text-xs text-slate-400 dark:text-slate-500 ml-2 flex-shrink-0">0 字</span>
      <button type="button" id="btn-outline" class="ml-1 p-1 rounded text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors flex-shrink-0" title="文章大纲">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
      </button>
    </div>

    <!-- 编辑区 + 预览区 -->
    <div class="flex-1 flex overflow-hidden" id="editor-split-container">
      <div class="flex flex-col border-r border-slate-200 dark:border-slate-700" id="editor-pane" style="flex: 0 0 50%;">
        <textarea id="editor-content" class="flex-1 w-full p-4 font-mono text-sm bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 focus:outline-none resize-none" placeholder="在这里写 Markdown 内容..."></textarea>
      </div>
      <!-- 拖拽条 -->
      <div class="w-1.5 bg-slate-200 dark:bg-slate-700 cursor-col-resize hover:bg-brand-400 dark:hover:bg-brand-500 transition-colors hidden md:block flex-shrink-0" id="editor-resizer" title="拖拽调整宽度"></div>
      <div class="flex-1 flex flex-col hidden md:flex" id="preview-pane">
        <div id="editor-preview" class="flex-1 overflow-y-auto p-4 prose prose-sm dark:prose-invert max-w-none"></div>
      </div>
    </div>
  </div>
</div>
