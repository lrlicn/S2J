---
interface Props {
  text: string;
  color?: 'brand' | 'green' | 'violet' | 'sky' | 'slate';
}

const { text, color = 'brand' } = Astro.props;

const colorClasses: Record<string, string> = {
  brand: 'bg-brand-100 text-brand-800 dark:bg-brand-900/40 dark:text-brand-300',
  green: 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300',
  violet: 'bg-violet-100 text-violet-800 dark:bg-violet-900/40 dark:text-violet-300',
  sky: 'bg-sky-100 text-sky-800 dark:bg-sky-900/40 dark:text-sky-300',
  slate: 'bg-slate-100 text-slate-800 dark:bg-slate-700 dark:text-slate-300',
};
---

<span class:list={['inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium', colorClasses[color]]}>
  {text}
</span>
